{
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev:css": "postcss ./assets/css/app.css -o ./assets/css/compiled-main.css --watch",
    "dev:js": "esbuild ./assets/js/src/main.js ./assets/js/src/smart-select.js ./assets/js/src/file-manager.js --outdir=./assets/js --watch",
    "dev": "npm run dev:css",
    "build:css": "cross-env NODE_ENV=production postcss ./assets/css/app.css -o ./assets/css/compiled-main.css",
    "build:js": "esbuild ./assets/js/src/main.js ./assets/js/src/smart-select.js ./assets/js/src/file-manager.js --minify --outdir=./assets/js",
    "build": "npm run build:css && npm run build:js"
  }
}
